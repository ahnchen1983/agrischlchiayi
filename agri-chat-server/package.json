{
  "name": "agri-chat-server",
  "version": "1.0.0",
  "description": "嘉義農業知識助手服務器（基於 OpenRouter + Gemini）",
  "main": "server.js",
  "scripts": {
    "build-index": "node build-knowledge-index.js",
    "prestart": "npm run build-index",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:search": "node -e \"const KB = require('./search.js'); const idx = require('./knowledge-index.json'); const s = new KB(idx); console.log(s.search('虱目魚養殖'));\""
  },
  "keywords": [
    "agriculture",
    "knowledge-base",
    "rag",
    "gemini",
    "openrouter"
  ],
  "author": "ahnchen",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
