# ============================================================
# 🔐 SECURITY CRITICAL — 絕不提交真實 API key
# ============================================================

# OpenRouter API Key
# 從 https://openrouter.io 獲取
# ⚠️ 只填入 .env.local，不要提交到 Git
OPENROUTER_API_KEY=sk_your_api_key_here

# OpenRouter model（可選；未設定時使用 google/gemini-2.5-flash）
OPENROUTER_MODEL=google/gemini-2.5-flash

# 服務器埠口（預設 3000）
PORT=3000

# Node 環境
# 可用值: development, staging, production
NODE_ENV=development

# CORS allowlist — 允許嵌入浮窗的網域（逗號分隔，不要空格）
# Production 必填。範例：
#   CORS_ORIGINS=https://ahnchen1983.github.io,http://localhost:4321
CORS_ORIGINS=

# ============================================================
# 使用說明
# ============================================================
#
# 1. 本地開發:
#    cp .env.example .env.local
#    # 編輯 .env.local，填入真實 API key
#
# 2. Render 部署:
#    設定環境變數在 Render Dashboard
#    不要在程式碼或 config 檔案中放 API key
#
# 3. Staging / Production:
#    使用分開的 API key（最小權限原則）
#    定期檢查使用量，異常時立即 rotate
#
