export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

# 🚨 Deidentification check (runs FIRST — blocks sensitive data before any other work)
# See DEIDENTIFICATION-POLICY.md for full policy
bash scripts/tools/deidentification-check.sh || exit 1

npx lint-staged

# Validate frontmatter on staged .md files in knowledge/
node scripts/core/test-frontmatter.mjs --staged

# Validate format (延伸閱讀格式 + [[wikilink]] 殘留 + 斷連結) on staged knowledge/*.md
# 為什麼：「規則在文件裡」≠「規則被執行」。2026-04-04 session η 的教訓。
staged_md=$(git diff --cached --name-only --diff-filter=ACM | grep '^knowledge/.*\.md$' | grep -v '^knowledge/en/' | grep -v '^knowledge/es/' | grep -v '^knowledge/ja/' || true)
if [ -n "$staged_md" ]; then
  format_fail=0
  link_fail=0
  for f in $staged_md; do
    # 忽略 _Hub 檔案
    [[ "$(basename "$f")" == _* ]] && continue
    # 檢查列表項目中的 [[wikilink]] 殘留（Astro 不渲染）
    if grep -n '^\s*- \[\[' "$f" > /dev/null 2>&1; then
      echo "❌ $f: 列表中有 [[wikilink]] 殘留（Astro 不渲染）"
      grep -n '^\s*- \[\[' "$f" | head -3
      echo "   修正: [[X]] → [X](/category/slug)"
      format_fail=1
    fi
    # 驗證所有 [[wikilink]] 目標存在
    broken=$(bash scripts/tools/wikilink-validate.sh "$f" 2>&1 | grep -c '❌' || true)
    if [ "$broken" -gt 0 ]; then
      echo "❌ $f: $broken 個斷裂 wikilink（目標不存在）"
      bash scripts/tools/wikilink-validate.sh "$f" 2>&1 | grep '❌' | head -3
      link_fail=1
    fi
  done
  if [ "$format_fail" = "1" ] || [ "$link_fail" = "1" ]; then
    echo ""
    echo "💡 跳過此檢查（緊急修復）: git commit --no-verify"
    exit 1
  fi
fi

# Hub sync check (runs LAST — global consistency across knowledge/)
# 為什麼：新增/刪除/重新命名 knowledge/<Cat>/*.md 後，10 類別 Hub 與 Crop-Index/Tech-Index 的
#       AUTO-GENERATED 區塊若未同步重建，前台類別頁的精選清單會缺。
# 為何放最後：deidentification/frontmatter/wikilink 是 per-file 檢查；本檢查是 cross-file 一致性。
# 工具：scripts/tools/regenerate-hubs.py（idempotent，含 --check 模式）
python3 scripts/tools/regenerate-hubs.py --check > /tmp/.hub-check.log 2>&1
hub_exit=$?
if [ "$hub_exit" -ne 0 ]; then
  echo ""
  echo "❌ Hub 索引與內容不同步："
  grep -E "△|不同步" /tmp/.hub-check.log | head -10
  echo ""
  echo "   修正: python3 scripts/tools/regenerate-hubs.py"
  echo "   然後重新 git add knowledge/ && git commit"
  echo ""
  echo "💡 跳過此檢查（緊急修復）: git commit --no-verify"
  rm -f /tmp/.hub-check.log
  exit 1
fi
rm -f /tmp/.hub-check.log
